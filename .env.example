# Google OAuth web client. Add GOOGLE_REDIRECT_URI to the OAuth client's
# authorized redirect URIs.
CLIENT_ID="351573358947-rj51hack9tvh7i16v3n7lchpn2mdcb5.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
FRONTEND_URL=http://127.0.0.1:5173/

# MongoDB (DB_URI may include credentials; otherwise DB_USERNAME/PASSWORD are used).
DB_URI=
DB_USERNAME=
DB_PASSWORD=
MONGODB_DATABASE=InboxPilot
MONGODB_USERS_COLLECTION=IP_users
MONGODB_EMAILS_COLLECTION=IP_emails

# Existing Pinecone index must have dimension 2048.
PINECONE=
PINECONE_INDEX_NAME=

# NVIDIA NIM embedding API.
NVAPI=
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# Gemini answer generation.
GEMINI=
GEMINI_MODEL=gemini-3.8-flash

# JWT signing and Google OAuth token encryption key. Use a long random secret.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Bounded processing settings.
EMAIL_FETCH_WORKERS=8
EMBEDDING_BATCH_SIZE=32
PINECONE_BATCH_SIZE=100
SYNC_OVERLAP_SECONDS=2
